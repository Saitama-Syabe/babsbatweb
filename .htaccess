# BAB'S-BAT — configuration Apache
Options -Indexes -MultiViews
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Calcule le dossier de base (/ en production, /personnalProject/babsbatweb/ sous XAMPP)
  RewriteCond %{REQUEST_URI}::$1 ^(.*?/)(.*)::\2$
  RewriteRule ^(.*)$ - [E=BASE:%1]

  # Adresse absolue du site pour les redirections, en https derrière le proxy (Traefik / Dokploy)
  RewriteRule ^ - [E=ORIGIN:%{REQUEST_SCHEME}://%{HTTP_HOST}]
  RewriteCond %{HTTP:X-Forwarded-Proto} ^https$ [NC]
  RewriteRule ^ - [E=ORIGIN:https://%{HTTP_HOST}]

  # Dossiers internes interdits au public
  RewriteRule ^(includes|storage|source-maquette|lib|old|bin)(/|$) - [F,L,NC]
  # Fichiers techniques interdits au public
  RewriteRule ^(Dockerfile|[^/]+\.md|router\.php|\.git.*|\.docker.*)$ - [F,L,NC]

  # Anciennes pages (v1) -> URL propres (redirection permanente)
  RewriteRule ^galerie\.html$          %{ENV:ORIGIN}%{ENV:BASE}chantiers [R=301,L,NC]
  RewriteRule ^nos_services\.html$     %{ENV:ORIGIN}%{ENV:BASE}metiers   [R=301,L,NC]
  RewriteRule ^nous_contacter\.html$   %{ENV:ORIGIN}%{ENV:BASE}contact   [R=301,L,NC]
  RewriteRule ^qui_sommes_nous\.html$  %{ENV:ORIGIN}%{ENV:BASE}#apropos  [R=301,L,NC,NE]
  RewriteRule ^index\.html$            %{ENV:ORIGIN}%{ENV:BASE}          [R=301,L,NC]
  RewriteRule ^(metiers|chantiers|contact)\.html$ %{ENV:ORIGIN}%{ENV:BASE}$1 [R=301,L,NC]

  # Adresse tapée avec .php -> URL propre (le nom du fichier n'apparaît jamais)
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s[^?\s]*/index\.php[?\s] [NC]
  RewriteRule ^index\.php$ %{ENV:ORIGIN}%{ENV:BASE} [R=301,L,NC]
  RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
  RewriteCond %{THE_REQUEST} \s[^?\s]*/(metiers|chantiers|contact)\.php[?\s] [NC]
  RewriteRule ^(metiers|chantiers|contact)\.php$ %{ENV:ORIGIN}%{ENV:BASE}%1 [R=301,L,NC]

  # Barre oblique finale superflue : /metiers/ -> /metiers
  RewriteRule ^(metiers|chantiers|contact)/$ %{ENV:ORIGIN}%{ENV:BASE}$1 [R=301,L,NC]

  # URL propre -> fichier PHP (réécriture interne, invisible pour le visiteur)
  RewriteRule ^(metiers|chantiers|contact)$ $1.php [L,NC]
</IfModule>

# Pages d'erreur
ErrorDocument 404 /404.php

# Cache des fichiers statiques
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
